# Networks to index. Any combination of: flare, songbird, coston, coston2
COMPOSE_PROFILES=flare,songbird

# RPC endpoints, required for the networks enabled above. The node has to keep
# more history than the indexer indexes; see history_epochs below. A node on
# this same box is reachable as http://host.docker.internal:9650/ext/bc/C/rpc.
FLARE_RPC_URL=
FLARE_RPC_API_KEY=
SONGBIRD_RPC_URL=
SONGBIRD_RPC_API_KEY=
COSTON_RPC_URL=
COSTON_RPC_API_KEY=
COSTON2_RPC_URL=
COSTON2_RPC_API_KEY=

# Past reward epochs kept fully indexed, i.e. how far back rewards can be
# calculated. Each one is 3.5 days on flare and songbird, much shorter on
# coston. Needs roughly (value + 3) x 3.5 days of node history on the mainnets.
FLARE_HISTORY_EPOCHS=2
SONGBIRD_HISTORY_EPOCHS=2
COSTON_HISTORY_EPOCHS=2
COSTON2_HISTORY_EPOCHS=2

# Max simultaneous RPC calls per indexer. Raise for a dedicated node, lower if
# the endpoint rate limits.
FLARE_RPC_CONCURRENCY=25
SONGBIRD_RPC_CONCURRENCY=25
COSTON_RPC_CONCURRENCY=25
COSTON2_RPC_CONCURRENCY=25

# Max blocks per eth_getLogs request. Set to the endpoint's getLogs cap.
FLARE_LOG_RANGE=1000
SONGBIRD_LOG_RANGE=1000
COSTON_LOG_RANGE=1000
COSTON2_LOG_RANGE=1000

# MySQL. reader is the only account the published port can use, so its password
# is required and may not contain a quote or a $. Firewall the port to the hosts
# that need it. The indexers use root over the compose network, which the port
# cannot reach; admin from the box is
#   docker compose exec indexer-db mysql -uroot -proot
DB_READER_PASSWORD=
DB_PUBLISHED_PORT=3306
